    {
        "id": "84113c3602930104",
        "type": "function",
        "z": "ee5baa48c91ec01d",
        "name": "Format MQTT command",
        "func": "// The P1AM firmware reads commands with readStringUntil('\\n').\nconst allowed = new Set(['TAKE_CONTROL', 'FORWARD', 'REVERSE', 'TURN', 'TURN_RIGHT',\n                         'SHARP_TURN', 'SHARP_TURN_RIGHT', 'STOP', 'SET_SPEED',\n                         'GO_DESTINATION_1', 'GO_DESTINATION_2', 'GO_DESTINATION_3',\n                         'GO_DESTINATION_4', 'GO_DESTINATION_5', 'GO_DESTINATION_6',\n                         'RELEASE_CONTROL']);\n\nconst command = String(msg.payload || '').trim().toUpperCase();\n\nif (!allowed.has(command)) {\n      node.warn('Blocked unknown robot command: ' + command);\n      return null;\n}\n\nmsg.payload = command + '\\n';\nmsg.topic = command;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 580,
        "wires": [
            [
                "4e0bd2a2a1e84b2f"
            ]
        ]
    },
    {
        "id": "8f3ad8ae93c85365",
        "type": "function",
        "z": "ee5baa48c91ec01d",
        "name": "Format SER9 response",
        "func": "const response = (msg.payload === undefined || msg.payload === null) ? '' : String(msg.payload).trim();\nmsg.payload = response || 'No response received — check TCP connection and controller.';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1510,
        "y": 520,
        "wires": [
            [
                "03a6fae781f9f73b"
            ]
        ]
    },
