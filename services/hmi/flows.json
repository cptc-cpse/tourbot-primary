    {
        "id": "494e70966f6d15a7",
        "type": "ui-template",
        "z": "ee5baa48c91ec01d",
        "group": "",
        "page": "",
        "ui": "ui_base_robot",
        "name": "Styling for all pages",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "\n/* =================================\n   INDUSTRIAL ROBOT CONTROL THEME\n   ================================= */\n\n:root {\n    --robot-bg: #111827;\n    --robot-panel: #1f2937;\n    --robot-border: #374151;\n    --robot-text: #f3f4f6;\n    --robot-muted: #9ca3af;\n    --robot-green: #16a34a;\n    --robot-red: #dc2626;\n    --robot-blue: #2563eb;\n}\n\n/* Main page background */\n.v-main {\n    background: var(--robot-bg) !important;\n    color: var(--robot-text);\n}\n\n/* Dashboard group panels */\n.nrdb-ui-group {\n    overflow: hidden;\n}\n\n/* Panel headings */\n.nrdb-ui-group .v-card-title {\n    color: var(--robot-text);\n    font-weight: 700;\n    letter-spacing: 0.04em;\n}\n\n/* Standard dashboard buttons */\n.nrdb-ui-button .v-btn {\n    min-height: 54px;\n    border-radius: 9px !important;\n    font-size: 15px;\n    font-weight: 700;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    transition: filter 0.15s ease;\n}\n\n/* Subtle hover feedback */\n.nrdb-ui-button .v-btn:hover {\n    filter: brightness(1.15);\n}\n\n/* Inputs and sliders */\n.nrdb-ui-slider,\n.nrdb-ui-text-input,\n.nrdb-ui-numeric-input {\n    color: var(--robot-text);\n}\n\n/* Consistent spacing */\n.nrdb-ui-group .v-card-text {\n    padding: 16px;\n}\n\n/* Make controls easier to use on touchscreens */\n@media (pointer: coarse) {\n    .nrdb-ui-button .v-btn {\n        min-height: 64px;\n        font-size: 17px;\n    }\n}\n",
        "noerr": 0,
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "site:style",
        "className": "",
        "x": 310,
        "y": 120,
        "wires": [
            []
        ]
    },
