        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "/* STOP button — high visibility */\n.stop-btn .v-btn {\n    background-color:  rgba(255, 0, 0, 0.8);\n    border: 1px solid rgba(255, 150, 150, 1)  \n}\n\n/* Movement buttons */\n.forward-btn .v-btn,\n.reverse-btn .v-btn {\n    background: rgba(0, 255, 68, 0.4);\n    border: 1px solid rgba(0, 255, 68, 1);\n}\n\n/* Turning buttons */\n.turn-btn .v-btn {\n    background-color: rgba(0, 113, 68, 0.4);\n    border: 1px solid rgba(0, 150, 68, 1);\n}\n\n.control-btn .v-btn {\n    background-color: rgba(0, 150, 255, 0.4);\n    border: 1px solid rgba(0, 150, 255, 1);\n}\n\n.home-btn .v-btn{\n    background-color: rgba(51, 78, 104, 0.75);\n    border: 1px solid rgba(100, 160, 210, 1);\n}",
